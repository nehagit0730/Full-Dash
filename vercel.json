{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/worldpay/reconcile-pending",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/subscriptions/cron",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/royalmail/sync-pending",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/recycle-bin/purge-expired",
      "schedule": "0 3 * * *"
    }
  ]
}
