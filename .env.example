# =============================================================================
# Environment variables
#
# Almost everything is configured in the admin dashboard:
#   Settings → API & integrations   payments, shipping, Cloudinary, Google
#                                   sign-in, reCAPTCHA, Vercel Analytics,
#                                   store URL, AgeChecked
#   Settings → Email & marketing    email provider (Gmail/SMTP/Resend), Klaviyo
#
# Credentials saved there are encrypted in the database and take effect
# immediately — no redeploy. Only the values below must live in the hosting
# environment (Vercel → Project → Settings → Environment Variables).
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — cannot be stored in the dashboard
# -----------------------------------------------------------------------------

# Neon PostgreSQL connection string. The dashboard's settings are stored in this
# database, so the app needs it before it can read anything else.
DATABASE_URL=

# Encrypts every credential saved in the dashboard (AES-256-GCM). It cannot be
# kept in the database it protects. Use the same value everywhere the app runs;
# changing it makes saved credentials unreadable (they must be re-entered).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# Signs admin and customer sessions. Changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# The administrator account. Kept outside the database so a database problem
# (or a compromised dashboard setting) can never lock you out or hand out admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# OPTIONAL
# -----------------------------------------------------------------------------

# Bearer token for an external scheduler calling /api/recycle-bin/purge-expired.
# CRON_SECRET=

# Local development only: allows repointing the running app at another
# database from the dashboard (always refused on Vercel).
# ALLOW_RUNTIME_DB_SWITCH=true

# -----------------------------------------------------------------------------
# LEGACY FALLBACKS — leave unset and use the dashboard instead.
# Still honoured so existing deployments keep working; a value saved in the
# dashboard always takes precedence.
# -----------------------------------------------------------------------------
# APP_URL=                      → Settings → API & integrations → Store URL
# CLOUDINARY_CLOUD_NAME= / CLOUDINARY_API_KEY= / CLOUDINARY_API_SECRET=
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=
# RECAPTCHA_SITE_KEY= / RECAPTCHA_SECRET_KEY=
# VERCEL_API_TOKEN= / VERCEL_PROJECT_ID= / VERCEL_TEAM_ID=
# AGECHECKED_SECRET_KEY= / AGECHECKED_BASE_URL=
# EMAIL_PROVIDER= / GMAIL_USER= / GMAIL_APP_PASSWORD= / SMTP_HOST= / SMTP_PORT=
# SMTP_SECURE= / SMTP_USER= / SMTP_PASSWORD= / RESEND_API_KEY= / RESEND_FROM_EMAIL=
# ADMIN_NOTIFICATION_EMAIL=
# KLAVIYO_API_KEY= / NEXT_PUBLIC_KLAVIYO_COMPANY_ID=
