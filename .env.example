# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Neon PostgreSQL Connection String
# Example: postgresql://username:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Payments (Razorpay) are configured in Admin → Payments, not here. Credentials
# are stored encrypted in Neon using SETTINGS_ENCRYPTION_KEY (below).

# Email Configuration (Gmail / SMTP / Resend)
EMAIL_PROVIDER=gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Klaviyo Marketing Automation Configuration
NEXT_PUBLIC_KLAVIYO_COMPANY_ID=
NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=
KLAVIYO_API_KEY=
KLAVIYO_SITE_ID=

# AgeChecked AC0130 Integration Configuration
AGECHECKED_SECRET_KEY=
AGECHECKED_BASE_URL=https://staging.agechecked.com/api/acapiremote/ac0130
NEXT_PUBLIC_AGECHECKED_PORTAL_URL=https://portal.agechecked.com/portal
NEXT_PUBLIC_AGECHECKED_PUBLIC_KEY=

# Auth.js / Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=

# ---------------------------------------------------------------------------
# Admin authentication — REQUIRED
#
# Without these the admin dashboard cannot sign anyone in (503) and every admin
# endpoint refuses every request. That is deliberate: a default secret would be
# a publicly known secret, so the code fails closed rather than open.
#
# AUTH_SECRET signs admin session tokens. At least 16 characters; generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every issued token, which is how you force a re-login.
AUTH_SECRET=

# The single administrator account. ADMIN_PASSWORD is the dashboard password —
# treat it like any other production credential and never commit a real value.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. There are no scheduled jobs in vercel.json. If you add an external
# scheduler later, it authenticates to /api/recycle-bin/purge-expired with this
# as a bearer token.
CRON_SECRET=






# ---------------------------------------------------------------------------
# Integration settings encryption — REQUIRED to save credentials from
# Settings → Payments / Shipping & Delivery / Integrations.
#
# 32-byte key (base64 or 64 hex chars). Credentials are AES-256-GCM encrypted
# with it before they reach the database. Without it, saving a secret is
# refused rather than stored in plain text. Changing it makes stored secrets
# unreadable (they show as "Misconfigured" and must be re-entered).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# Leave unset. Only for local development: allows POST /api/update-db-uri to
# repoint the running app at another database (always refused on Vercel).
# ALLOW_RUNTIME_DB_SWITCH=false
